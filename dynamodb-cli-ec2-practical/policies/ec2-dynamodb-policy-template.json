{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ItemCrudOnlyOnStudentsLab",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/StudentsLab"
    }
  ]
}
